# Configuracao de PRODUCAO do front web. O workflow de deploy copia este arquivo
# por cima do .env antes do `flutter build web` — o dotenv e um ASSET do bundle,
# entao o valor fica embutido no build e nao da para trocar depois.
#
# TROQUE api.seudominio.com pelo dominio real da API (o mesmo API_DOMAIN do .env
# da trilha-infra, para o qual o Caddy emite o certificado).
#
# As tres URLs apontam para o MESMO host de proposito: o Caddy roteia por path
# (/bff -> BFF, /arquivo -> Midia, /ws-localizacao -> Localizacao). Assim os
# servicos internos continuam sem porta publicada.

# Base do BFF.
API_BASE_URL=https://api.seudominio.com
# Servico de Midia: upload de fotos vai direto nele (nao passa pelo BFF).
MIDIA_BASE_URL=https://api.seudominio.com
# WebSocket do servico de Localizacao (STOMP/SockJS): acompanhar trilha ao vivo.
# Sobre https o SockJS negocia wss:// sozinho — manter https aqui.
LOC_WS_URL=https://api.seudominio.com/ws-localizacao
